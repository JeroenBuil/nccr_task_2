<PsychoPy2experiment encoding="utf-8" version="2026.1.0">
    <Settings>
        <Param name="expName" val="posner_task" valType="str" updates="None" plugin="None"/>
        <Param name="expVersion" val="" valType="str" updates="None" plugin="None"/>
        <Param name="Audio lib" val="use prefs" valType="str" updates="None" plugin="None"/>
        <Param name="Force stereo" val="True" valType="bool" updates="None" plugin="None"/>
        <Param name="exportHTML" val="on Sync" valType="str" updates="None" plugin="None"/>
        <Param name="Completed URL" val="" valType="str" updates="None" plugin="None"/>
        <Param name="Incomplete URL" val="" valType="str" updates="None" plugin="None"/>
        <Param name="End Message" val="Thank you for your patience." valType="str" updates="None" plugin="None"/>
        <Param name="Resources" val="[]" valType="list" updates="None" plugin="None"/>
        <Param name="runMode" val="1" valType="code" updates="None" plugin="None"/>
        <Param name="Use version" val="" valType="str" updates="None" plugin="None"/>
        <Param name="Enable Escape" val="True" valType="bool" updates="None" plugin="None"/>
        <Param name="rush" val="False" valType="bool" updates="None" plugin="None"/>
        <Param name="Show info dlg" val="True" valType="bool" updates="None" plugin="None"/>
        <Param name="Experiment info" val="{&quot;participant&quot;:&quot;f\&quot;{randint(0, 999999):06.0f}\&quot;&quot;,&quot;session&quot;:&quot;001&quot;}" valType="code" updates="None" plugin="None"/>
        <Param name="Monitor" val="testMonitor" valType="str" updates="None" plugin="None"/>
        <Param name="winBackend" val="pyglet" valType="str" updates="None" plugin="None"/>
        <Param name="Screen" val="1" valType="num" updates="None" plugin="None"/>
        <Param name="Full-screen window" val="True" valType="bool" updates="None" plugin="None"/>
        <Param name="Window size (pixels)" val="[1024,768]" valType="list" updates="None" plugin="None"/>
        <Param name="Show mouse" val="False" valType="bool" updates="None" plugin="None"/>
        <Param name="Units" val="height" valType="str" updates="None" plugin="None"/>
        <Param name="color" val="$[0,0,0]" valType="color" updates="None" plugin="None"/>
        <Param name="blendMode" val="avg" valType="str" updates="None" plugin="None"/>
        <Param name="colorSpace" val="rgb" valType="str" updates="None" plugin="None"/>
        <Param name="backgroundImg" val="" valType="str" updates="None" plugin="None"/>
        <Param name="backgroundFit" val="none" valType="str" updates="None" plugin="None"/>
        <Param name="measureFrameRate" val="True" valType="bool" updates="None" plugin="None"/>
        <Param name="frameRate" val="" valType="code" updates="None" plugin="None"/>
        <Param name="frameRateMsg" val="Attempting to measure frame rate of screen, please wait..." valType="str" updates="None" plugin="None"/>
        <Param name="Data filename" val="'data/' + expInfo['participant'] + '_' + expName + '_' + expInfo['date']" valType="code" updates="None" plugin="None"/>
        <Param name="Data file delimiter" val="auto" valType="str" updates="None" plugin="None"/>
        <Param name="sortColumns" val="time" valType="str" updates="None" plugin="None"/>
        <Param name="colPriority" val="{&quot;thisRow.t&quot;:&quot;priority.CRITICAL&quot;,&quot;expName&quot;:&quot;priority.LOW&quot;}" valType="dict" updates="None" plugin="None"/>
        <Param name="Save excel file" val="False" valType="bool" updates="None" plugin="None"/>
        <Param name="Save log file" val="True" valType="bool" updates="None" plugin="None"/>
        <Param name="Save csv file" val="False" valType="bool" updates="None" plugin="None"/>
        <Param name="Save wide csv file" val="True" valType="bool" updates="None" plugin="None"/>
        <Param name="Save psydat file" val="True" valType="bool" updates="None" plugin="None"/>
        <Param name="Save hdf5 file" val="False" valType="bool" updates="None" plugin="None"/>
        <Param name="logging level" val="info" valType="code" updates="None" plugin="None"/>
        <Param name="consoleLoggingLevel" val="warning" valType="code" updates="None" plugin="None"/>
        <Param name="clockFormat" val="float" valType="str" updates="None" plugin="None"/>
        <Param name="eyetracker" val="None" valType="str" updates="None" plugin="None"/>
        <Param name="mgMove" val="CONTINUOUS" valType="str" updates="None" plugin="None"/>
        <Param name="mgBlink" val="MIDDLE_BUTTON" valType="list" updates="None" plugin="None"/>
        <Param name="mgSaccade" val="0.5" valType="num" updates="None" plugin="None"/>
        <Param name="keyboardBackend" val="PsychToolbox" valType="str" updates="None" plugin="None"/>
        <Param name="HTML path" val="" valType="str" updates="None" plugin="None"/>
    </Settings>
    <Routines>
        <Routine name="trial">
            <RoutineSettingsComponent name="trial" plugin="None">
                <Param name="name" val="trial" valType="code" updates="None" plugin="None"/>
                <Param name="stopVal" val="" valType="code" updates="constant" plugin="None"/>
                <Param name="durationEstim" val="" valType="code" updates="None" plugin="None"/>
                <Param name="stopType" val="duration (s)" valType="str" updates="None" plugin="None"/>
                <Param name="forceNonSlip" val="False" valType="code" updates="None" plugin="None"/>
                <Param name="skipIf" val="" valType="code" updates="constant" plugin="None"/>
                <Param name="useWindowParams" val="False" valType="bool" updates="None" plugin="None"/>
                <Param name="color" val="$[0,0,0]" valType="color" updates="None" plugin="None"/>
                <Param name="colorSpace" val="rgb" valType="str" updates="None" plugin="None"/>
                <Param name="backgroundImg" val="" valType="str" updates="None" plugin="None"/>
                <Param name="backgroundFit" val="none" valType="str" updates="None" plugin="None"/>
                <Param name="saveStartStop" val="True" valType="bool" updates="None" plugin="None"/>
                <Param name="disabled" val="False" valType="bool" updates="None" plugin="None"/>
                <Param name="desc" val="" valType="str" updates="constant" plugin="None"/>
            </RoutineSettingsComponent>
            <CodeComponent name="trialCode" plugin="None">
                <Param name="name" val="trialCode" valType="code" updates="None" plugin="None"/>
                <Param name="Code Type" val="Py" valType="str" updates="None" plugin="None"/>
                <Param name="disabled" val="False" valType="bool" updates="None" plugin="None"/>
                <Param name="Before Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin Routine" val="soa = np.random.uniform(0.2, 0.6)   # jittered SOA, 200-600 ms&#10;thisExp.addData('soa', soa) # writes soa + its value in the output data file&#10;&#10;# onset times (all relative to trial routine start t=0)&#10;fix_dur   = 0.5&#10;cue_onset = fix_dur&#10;cue_dur   = 0.1&#10;target_onset = cue_onset + cue_dur + soa&#10;&#10;# initalise / reset flags&#10;fix_sent = False&#10;cue_sent = False&#10;target_sent = False" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Each Frame" val="# Each frame check if the timer has passed the onset time of that event&#10;# if so, send the trigger and set the flag to true to avoid consequtive triggers this routine&#10;if not fix_sent and t &gt;= 0:&#10;    send_trigger('FIX_ONSET')&#10;    fix_sent = True&#10;if not cue_sent and t &gt;= cue_onset:&#10;    send_trigger('CUE_LEFT' if cueSide == 'left' else 'CUE_RIGHT')&#10;    cue_sent = True&#10;if not target_sent and t &gt;= target_onset:&#10;    send_trigger('TARGET_LEFT' if targetSide == 'left' else 'TARGET_RIGHT')&#10;    target_sent = True" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End Routine" val="# If a key is pressed:&#10;if respTrial.keys:&#10;    # is_correct = 1 if the key pressed matches the side the target appeared, else 0&#10;    is_correct = 1 if ((respTrial.keys == 'left' and targetSide == 'left') or&#10;                      (respTrial.keys == 'right' and targetSide == 'right')) else 0&#10;    send_trigger('RESPONSE_CORRECT' if is_correct == 1 else 'RESPONSE_INCORRECT')&#10;    thisExp.addData('correct', is_correct)&#10;    thisExp.addData('rt', respTrial.rt)&#10;# Else: no key is pressed before the routine ended =&gt; l&#10;else:&#10;    # write incorrect trial and empty response&#10;    thisExp.addData('correct', 0)&#10;    thisExp.addData('rt', '')&#10;    send_trigger('RESPONE_TIMEOUT')" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Before JS Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin JS Experiment" val="import * as time from 'time';&#10;triggerLog = open((filename + &quot;_triggers.tsv&quot;), &quot;w&quot;);&#10;triggerLog.write(&quot;trial\tevent\tcode\tt_exp\tt_routine\n&quot;);&#10;function send_trigger(code, event_name) {&#10;    var line;&#10;    line = `${trials.thisN}&#9;${event_name}&#9;${code}&#9;${util.pad(Number.parseFloat(globalClock.getTime()).toFixed(4), 1)}&#9;${util.pad(Number.parseFloat(t).toFixed(4), 1)}&#10;`;&#10;    triggerLog.write(line);&#10;    triggerLog.flush();&#10;}&#10;" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin JS Routine" val="import * as random from 'random';&#10;soa = Math.random.uniform(0.2, 0.6);&#10;cueOnset = 0.5;&#10;cueDur = 0.1;&#10;targetOnset = ((cueOnset + cueDur) + soa);&#10;psychoJS.experiment.addData(&quot;soa&quot;, soa);&#10;cueTriggered = false;&#10;targetTriggered = false;&#10;respTriggered = false;&#10;" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Each JS Frame" val="if (((t &gt; (targetOnset + 1.5)) &amp;&amp; (resp.keys === []))) {&#10;    continueRoutine = false;&#10;}&#10;if (((cue.status === PsychoJS.Status.STARTED) &amp;&amp; (! cueTriggered))) {&#10;    send_trigger(1, &quot;cue_onset&quot;);&#10;    cueTriggered = true;&#10;}&#10;if (((target.status === PsychoJS.Status.STARTED) &amp;&amp; (! targetTriggered))) {&#10;    send_trigger(2, &quot;target_onset&quot;);&#10;    targetTriggered = true;&#10;}&#10;if ((resp.keys &amp;&amp; (! respTriggered))) {&#10;    send_trigger(3, &quot;response&quot;);&#10;    respTriggered = true;&#10;}&#10;" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End JS Routine" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End JS Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
            </CodeComponent>
            <ImageComponent name="fixation" plugin="None">
                <Param name="name" val="fixation" valType="code" updates="None" plugin="None"/>
                <Param name="startVal" val="0" valType="code" updates="None" plugin="None"/>
                <Param name="startEstim" val="" valType="code" updates="None" plugin="None"/>
                <Param name="startType" val="time (s)" valType="str" updates="None" plugin="None"/>
                <Param name="stopVal" val="" valType="code" updates="constant" plugin="None"/>
                <Param name="durationEstim" val="" valType="code" updates="None" plugin="None"/>
                <Param name="stopType" val="duration (s)" valType="str" updates="None" plugin="None"/>
                <Param name="color" val="$[1,1,1]" valType="color" updates="constant" plugin="None"/>
                <Param name="colorSpace" val="rgb" valType="str" updates="constant" plugin="None"/>
                <Param name="opacity" val="" valType="num" updates="constant" plugin="None"/>
                <Param name="size" val="SIZE_X_Y" valType="list" updates="constant" plugin="None"/>
                <Param name="pos" val="[0,0]" valType="list" updates="constant" plugin="None"/>
                <Param name="units" val="from exp settings" valType="str" updates="None" plugin="None"/>
                <Param name="anchor" val="center" valType="str" updates="constant" plugin="None"/>
                <Param name="ori" val="0" valType="num" updates="constant" plugin="None"/>
                <Param name="image" val="posner/fixation_cross.png" valType="file" updates="constant" plugin="None"/>
                <Param name="mask" val="" valType="str" updates="constant" plugin="None"/>
                <Param name="texture resolution" val="128" valType="num" updates="constant" plugin="None"/>
                <Param name="saveStartStop" val="True" valType="bool" updates="None" plugin="None"/>
                <Param name="syncScreenRefresh" val="True" valType="bool" updates="None" plugin="None"/>
                <Param name="disabled" val="False" valType="bool" updates="None" plugin="None"/>
                <Param name="contrast" val="1" valType="num" updates="constant" plugin="None"/>
                <Param name="validator" val="" valType="code" updates="None" plugin="None"/>
                <Param name="interpolate" val="linear" valType="str" updates="constant" plugin="None"/>
                <Param name="flipVert" val="False" valType="bool" updates="constant" plugin="None"/>
                <Param name="flipHoriz" val="False" valType="bool" updates="constant" plugin="None"/>
                <Param name="draggable" val="False" valType="code" updates="constant" plugin="None"/>
            </ImageComponent>
            <ImageComponent name="boxLeft" plugin="None">
                <Param name="name" val="boxLeft" valType="code" updates="None" plugin="None"/>
                <Param name="startVal" val="0" valType="code" updates="None" plugin="None"/>
                <Param name="startEstim" val="" valType="code" updates="None" plugin="None"/>
                <Param name="startType" val="time (s)" valType="str" updates="None" plugin="None"/>
                <Param name="stopVal" val="" valType="code" updates="constant" plugin="None"/>
                <Param name="durationEstim" val="" valType="code" updates="None" plugin="None"/>
                <Param name="stopType" val="duration (s)" valType="str" updates="None" plugin="None"/>
                <Param name="color" val="$[1,1,1]" valType="color" updates="constant" plugin="None"/>
                <Param name="colorSpace" val="rgb" valType="str" updates="constant" plugin="None"/>
                <Param name="opacity" val="" valType="num" updates="constant" plugin="None"/>
                <Param name="size" val="SIZE_X_Y" valType="list" updates="constant" plugin="None"/>
                <Param name="pos" val="-X_COORD,0" valType="list" updates="constant" plugin="None"/>
                <Param name="units" val="from exp settings" valType="str" updates="None" plugin="None"/>
                <Param name="anchor" val="center" valType="str" updates="constant" plugin="None"/>
                <Param name="ori" val="0" valType="num" updates="constant" plugin="None"/>
                <Param name="image" val="posner/box.png" valType="file" updates="constant" plugin="None"/>
                <Param name="mask" val="" valType="str" updates="constant" plugin="None"/>
                <Param name="texture resolution" val="128" valType="num" updates="constant" plugin="None"/>
                <Param name="saveStartStop" val="True" valType="bool" updates="None" plugin="None"/>
                <Param name="syncScreenRefresh" val="True" valType="bool" updates="None" plugin="None"/>
                <Param name="disabled" val="False" valType="bool" updates="None" plugin="None"/>
                <Param name="contrast" val="1" valType="num" updates="constant" plugin="None"/>
                <Param name="validator" val="" valType="code" updates="None" plugin="None"/>
                <Param name="interpolate" val="linear" valType="str" updates="constant" plugin="None"/>
                <Param name="flipVert" val="False" valType="bool" updates="constant" plugin="None"/>
                <Param name="flipHoriz" val="False" valType="bool" updates="constant" plugin="None"/>
                <Param name="draggable" val="False" valType="code" updates="constant" plugin="None"/>
            </ImageComponent>
            <ImageComponent name="boxRight" plugin="None">
                <Param name="name" val="boxRight" valType="code" updates="None" plugin="None"/>
                <Param name="startVal" val="0" valType="code" updates="None" plugin="None"/>
                <Param name="startEstim" val="" valType="code" updates="None" plugin="None"/>
                <Param name="startType" val="time (s)" valType="str" updates="None" plugin="None"/>
                <Param name="stopVal" val="" valType="code" updates="constant" plugin="None"/>
                <Param name="durationEstim" val="" valType="code" updates="None" plugin="None"/>
                <Param name="stopType" val="duration (s)" valType="str" updates="None" plugin="None"/>
                <Param name="color" val="$[1,1,1]" valType="color" updates="constant" plugin="None"/>
                <Param name="colorSpace" val="rgb" valType="str" updates="constant" plugin="None"/>
                <Param name="opacity" val="" valType="num" updates="constant" plugin="None"/>
                <Param name="size" val="SIZE_X_Y" valType="list" updates="constant" plugin="None"/>
                <Param name="pos" val="X_COORD,0" valType="list" updates="constant" plugin="None"/>
                <Param name="units" val="from exp settings" valType="str" updates="None" plugin="None"/>
                <Param name="anchor" val="center" valType="str" updates="constant" plugin="None"/>
                <Param name="ori" val="0" valType="num" updates="constant" plugin="None"/>
                <Param name="image" val="posner/box.png" valType="file" updates="constant" plugin="None"/>
                <Param name="mask" val="" valType="str" updates="constant" plugin="None"/>
                <Param name="texture resolution" val="128" valType="num" updates="constant" plugin="None"/>
                <Param name="saveStartStop" val="True" valType="bool" updates="None" plugin="None"/>
                <Param name="syncScreenRefresh" val="True" valType="bool" updates="None" plugin="None"/>
                <Param name="disabled" val="False" valType="bool" updates="None" plugin="None"/>
                <Param name="contrast" val="1" valType="num" updates="constant" plugin="None"/>
                <Param name="validator" val="" valType="code" updates="None" plugin="None"/>
                <Param name="interpolate" val="linear" valType="str" updates="constant" plugin="None"/>
                <Param name="flipVert" val="False" valType="bool" updates="constant" plugin="None"/>
                <Param name="flipHoriz" val="False" valType="bool" updates="constant" plugin="None"/>
                <Param name="draggable" val="False" valType="code" updates="constant" plugin="None"/>
            </ImageComponent>
            <ImageComponent name="cue" plugin="None">
                <Param name="name" val="cue" valType="code" updates="None" plugin="None"/>
                <Param name="startVal" val="$cue_onset" valType="code" updates="None" plugin="None"/>
                <Param name="startEstim" val="" valType="code" updates="None" plugin="None"/>
                <Param name="startType" val="time (s)" valType="str" updates="None" plugin="None"/>
                <Param name="stopVal" val="$cue_dur" valType="code" updates="constant" plugin="None"/>
                <Param name="durationEstim" val="" valType="code" updates="None" plugin="None"/>
                <Param name="stopType" val="duration (s)" valType="str" updates="None" plugin="None"/>
                <Param name="color" val="$[1,1,1]" valType="color" updates="constant" plugin="None"/>
                <Param name="colorSpace" val="rgb" valType="str" updates="constant" plugin="None"/>
                <Param name="opacity" val="" valType="num" updates="constant" plugin="None"/>
                <Param name="size" val="SIZE_X_Y" valType="list" updates="constant" plugin="None"/>
                <Param name="pos" val="(0, Y_COORD) if cueType=='endogenous' else ((-X_COORD,0) if cueSide=='left' else (X_COORD,0))" valType="list" updates="set every repeat" plugin="None"/>
                <Param name="units" val="from exp settings" valType="str" updates="None" plugin="None"/>
                <Param name="anchor" val="center" valType="str" updates="constant" plugin="None"/>
                <Param name="ori" val="0" valType="num" updates="constant" plugin="None"/>
                <Param name="image" val="$cueFile" valType="file" updates="set every repeat" plugin="None"/>
                <Param name="mask" val="" valType="str" updates="constant" plugin="None"/>
                <Param name="texture resolution" val="128" valType="num" updates="constant" plugin="None"/>
                <Param name="saveStartStop" val="True" valType="bool" updates="None" plugin="None"/>
                <Param name="syncScreenRefresh" val="True" valType="bool" updates="None" plugin="None"/>
                <Param name="disabled" val="False" valType="bool" updates="None" plugin="None"/>
                <Param name="contrast" val="1" valType="num" updates="constant" plugin="None"/>
                <Param name="validator" val="" valType="code" updates="None" plugin="None"/>
                <Param name="interpolate" val="linear" valType="str" updates="constant" plugin="None"/>
                <Param name="flipVert" val="False" valType="bool" updates="constant" plugin="None"/>
                <Param name="flipHoriz" val="False" valType="bool" updates="constant" plugin="None"/>
                <Param name="draggable" val="False" valType="code" updates="constant" plugin="None"/>
            </ImageComponent>
            <ImageComponent name="target" plugin="None">
                <Param name="name" val="target" valType="code" updates="None" plugin="None"/>
                <Param name="startVal" val="$target_onset" valType="code" updates="None" plugin="None"/>
                <Param name="startEstim" val="" valType="code" updates="None" plugin="None"/>
                <Param name="startType" val="time (s)" valType="str" updates="None" plugin="None"/>
                <Param name="stopVal" val="" valType="code" updates="constant" plugin="None"/>
                <Param name="durationEstim" val="" valType="code" updates="None" plugin="None"/>
                <Param name="stopType" val="duration (s)" valType="str" updates="None" plugin="None"/>
                <Param name="color" val="$[1,1,1]" valType="color" updates="constant" plugin="None"/>
                <Param name="colorSpace" val="rgb" valType="str" updates="constant" plugin="None"/>
                <Param name="opacity" val="" valType="num" updates="constant" plugin="None"/>
                <Param name="size" val="SIZE_X_Y" valType="list" updates="constant" plugin="None"/>
                <Param name="pos" val="$(-X_COORD,0) if targetSide=='left' else (X_COORD,0)" valType="list" updates="set every repeat" plugin="None"/>
